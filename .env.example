# =========================================================
# SafeTrack — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs.
# Générez les secrets avec : node scripts/gen-env.js
# =========================================================

# Port d'écoute du serveur (défaut : 3000)
PORT=3000

# Environnement : development | production
NODE_ENV=development

# Secret de session (32 octets aléatoires, généré par gen-env.js)
SESSION_SECRET=

# Clé de chiffrement des données sensibles AES-256-GCM (32 octets hex, 64 car.)
DATA_ENCRYPTION_KEY=

# Chemin de la base de données SQLite
DB_PATH=./backend/safetrack.db

# URL publique de l'application (ex : https://safetrack.exemple.com)
# Laissez vide en développement
PUBLIC_BASE_URL=

# Origines autorisées pour CORS (séparées par des virgules)
# Ex : https://safetrack.exemple.com
ALLOWED_ORIGINS=

# Faire confiance aux en-têtes X-Forwarded-* (reverse proxy) : true | false
TRUST_PROXY=false

# Notificateur par défaut : outbox (log en base) | smtp | sms
NOTIFIER=outbox
